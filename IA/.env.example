# =============================================================================
# NutriGuide IA (n8n + Qdrant) - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como IA/.env y pon tu GEMINI_API_KEY. Nunca subas el .env a git.
# Lo leen docker compose y el backend automáticamente.
# =============================================================================

# Clave de Google Gemini (https://aistudio.google.com/apikey).
# Se usa para los embeddings y las respuestas (modelos configurables más abajo).
GEMINI_API_KEY=

# Modelos de Google Gemini. Consulta los disponibles para tu clave en
# https://ai.google.dev/gemini-api/docs/models (Google retira modelos antiguos).
# - Chat: un modelo rápido; los Gemini 3 "flash" completos razonan por defecto y pueden tardar minutos.
# - Embeddings: si lo cambias, borra la colección de Qdrant y reindexa los documentos
#   (cada modelo genera vectores distintos).
GEMINI_MODELO_CHAT=models/gemini-3.5-flash-lite
GEMINI_MODELO_EMBEDDINGS=models/gemini-embedding-001

# ---- Opcional: sin estas tres líneas se usan valores de desarrollo (sirven en local).
# Para un servidor compartido, descoméntalas con valores largos y aleatorios.
#
# Token de los webhooks de n8n. El backend lo lee de este mismo archivo, así que siempre coinciden.
# NUTRIGUIDE_WEBHOOK_TOKEN=pon-aqui-un-token-largo

# Clave de la API de Qdrant (protege la base vectorial).
# QDRANT_API_KEY=pon-aqui-una-clave-larga

# Clave con la que n8n cifra sus credenciales. Defínela ANTES del primer arranque y no la cambies después.
# N8N_ENCRYPTION_KEY=pon-aqui-una-clave-larga

# Similitud coseno mínima (0..1) para usar un fragmento recuperado de Qdrant.
RAG_MIN_SIMILARITY=0.55

# Puertos en el equipo: editor/webhooks de n8n y API de Qdrant
N8N_PUERTO=5680
QDRANT_PUERTO=6333

# Zona horaria de n8n
TZ=America/Bogota

# Solo para pruebas: servidor alternativo de la API de Gemini (por defecto, el de Google)
# GEMINI_HOST=https://generativelanguage.googleapis.com
