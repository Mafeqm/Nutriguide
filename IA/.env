# =============================================================================
# NutriGuide IA (n8n + Qdrant) - VARIABLES DE ENTORNO LOCALES (NO SUBIR A GIT)
# Copia este archivo como IA/.env y rellena los valores. Nunca subas el .env a git.
# docker compose lo lee automáticamente desde esta carpeta.
# =============================================================================

# Clave de Google Gemini (https://aistudio.google.com/apikey).
# Se usa para los embeddings (gemini-embedding-001) y las respuestas (gemini-2.5-flash).
GEMINI_API_KEY= AQ.Ab8RN6L-oUlK5By-e4hbfUGf6sqaub0YwSi2YvyjzbbyKkMh9g

# Modelos de Google Gemini. Consulta los disponibles para tu clave en
# https://ai.google.dev/gemini-api/docs/models (Google retira modelos antiguos).
# - Chat: un modelo rápido; los Gemini 3 "flash" completos razonan por defecto y pueden tardar minutos.
# - Embeddings: si lo cambias, borra la colección de Qdrant y reindexa los documentos
#   (cada modelo genera vectores distintos).
GEMINI_MODELO_CHAT=models/gemini-3.5-flash-lite
GEMINI_MODELO_EMBEDDINGS=models/gemini-embedding-001

# Token compartido con el backend: el backend lo envía en la cabecera X-NutriGuide-Token
# y n8n rechaza cualquier llamada sin él. Usa un valor largo y aleatorio.
NUTRIGUIDE_WEBHOOK_TOKEN=8612468c78a51dee770ce0319aa9ef8cfaa7791458d00a22

# Clave de la API de Qdrant (protege la base vectorial). Valor largo y aleatorio.
QDRANT_API_KEY=9dd3a4c54c53276b98089fd5a67c9a99afca6637069d3a8d

# Clave con la que n8n cifra las credenciales guardadas. No la cambies después del primer arranque.
N8N_ENCRYPTION_KEY=5dddf59f1d14e55e01fb18feaa3e72e456446330400078e1

# Similitud coseno mínima (0..1) para usar un fragmento recuperado de Qdrant.
RAG_MIN_SIMILARITY=0.55

# Puertos en el equipo: editor/webhooks de n8n y API de Qdrant
N8N_PUERTO=5680
QDRANT_PUERTO=6333

# Zona horaria de n8n
TZ=America/Bogota

# Solo para pruebas: servidor alternativo de la API de Gemini (por defecto, el de Google)
# GEMINI_HOST=https://generativelanguage.googleapis.com
