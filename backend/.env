# =============================================================================
# NUTRIGUIDE BACKEND - VARIABLES DE ENTORNO LOCALES (NO SUBIR A GIT)
# Opcional: Spring Boot lee este archivo automáticamente al arrancar (IntelliJ o mvnw),
# y docker-compose también. Sin él se usan los valores de desarrollo.
# Nunca subas un .env con valores reales (está en .gitignore).
# =============================================================================

# Servidor
SERVER_PORT=8080

# PostgreSQL (docker-compose expone el puerto 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=nutriguide_db
DB_USERNAME=nutriguide
# Contraseña de desarrollo local (docker-compose y backend usan la misma). Cámbiala fuera de desarrollo.
DB_PASSWORD=nutriguide_dev_pass

# Asistente de IA (n8n + Qdrant): el backend toma el token de los webhooks de IA/.env
# automáticamente; no hace falta repetirlo aquí. N8N_URL solo si n8n no está en localhost:5680.
# N8N_URL=http://localhost:5680

# Token para crear/modificar/borrar datos y cargar documentos (cabecera X-Admin-Token).
# Usa un valor largo y aleatorio. Si se deja vacío, esas operaciones quedan deshabilitadas.
ADMIN_TOKEN=e89912692a9a968d122ac6b8168fdd0d7b70a88c63122253

# Orígenes del frontend permitidos por CORS (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Máximo de preguntas al chat por IP y minuto (0 = sin límite)
CHAT_RATE_LIMIT=20

# Carpeta donde se guardan los documentos subidos
UPLOAD_DIR=./uploads/documentos
