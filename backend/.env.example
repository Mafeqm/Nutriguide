# =============================================================================
# NUTRIGUIDE BACKEND - VARIABLES DE ENTORNO DE EJEMPLO (SIN CREDENCIALES REALES)
# Copia este archivo como .env o exporta las variables en tu consola antes de ejecutar.
# =============================================================================

# Puerto del servidor Spring Boot
SERVER_PORT=8080

# Configuración de PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nutriguide_db
DB_USERNAME=nutriguide
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# Credenciales de Google Gemini API (Obtener en https://aistudio.google.com/apikey)
GEMINI_API_KEY=TU_CLAVE_PRIVADA_GEMINI_AQUI
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# Habilitar respaldo local si no se cuenta con conexión a la API externa (true/false)
AI_EMBEDDING_FALLBACK_ENABLED=true

# Orígenes permitidos para CORS (Frontend HTML/CSS/JS)
CORS_ALLOWED_ORIGINS=*

