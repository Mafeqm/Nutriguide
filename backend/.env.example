# =============================================================================
# NUTRIGUIDE BACKEND - VARIABLES DE ENTORNO DE EJEMPLO (SIN CREDENCIALES REALES)
# Spring Boot no lee este archivo por sí solo: define las variables en tu terminal
# o en la configuración de ejecución de tu IDE (ver backend/README.md).
# docker-compose sí lee un archivo .env ubicado en esta carpeta.
# Nunca subas un .env con valores reales (está en .gitignore).
# =============================================================================

# Servidor
SERVER_PORT=8080

# PostgreSQL + pgvector (docker-compose expone el puerto 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=nutriguide_db
DB_USERNAME=nutriguide
# Contraseña de desarrollo local (docker-compose y backend usan la misma). Cámbiala fuera de desarrollo.
DB_PASSWORD=nutriguide_dev_pass

# Google Gemini (https://aistudio.google.com/apikey). Sin ella el chat responde 503.
GEMINI_API_KEY=TU_CLAVE_PRIVADA_GEMINI_AQUI
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# Similitud coseno mínima para aceptar un fragmento en el RAG (0..1)
RAG_MIN_SIMILARITY=0.55

# Token para crear/modificar/borrar datos y cargar documentos (cabecera X-Admin-Token).
# Usa un valor largo y aleatorio. Si se deja vacío, esas operaciones quedan deshabilitadas.
ADMIN_TOKEN=CAMBIA_ESTE_TOKEN

# Orígenes del frontend permitidos por CORS (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Máximo de preguntas al chat por IP y minuto (0 = sin límite)
CHAT_RATE_LIMIT=20

# Carpeta donde se guardan los documentos subidos
UPLOAD_DIR=./uploads/documentos
